<?xml version="1.0"?>
<Container version="2">
  <Name>lan-drop</Name>
  <Repository>ghcr.io/i1k3r/lan-drop:latest</Repository>
  <Registry>https://github.com/i1k3r/lan-drop/pkgs/container/lan-drop</Registry>
  <Network>bridge</Network>
  <Privileged>false</Privileged>
  <Support>https://github.com/i1k3r/lan-drop/issues</Support>
  <Project>https://github.com/i1k3r/lan-drop</Project>
  <Overview>Self-hosted, temporary browser-based file-sharing application for local networks. Features QR code sharing, streaming uploads/downloads up to 10 GiB, optional PIN protection, background cleanup, and temporary Global Share links.</Overview>
  <Category>Tools: Productivity: Network:Web</Category>
  <WebUI>http://[IP]:[PORT:7700]</WebUI>
  <ExtraParams>--read-only --tmpfs /tmp --security-opt no-new-privileges:true</ExtraParams>
  <Networking>
    <Mode>bridge</Mode>
    <Publish>
      <Port>
        <HostPort>7700</HostPort>
        <ContainerPort>7700</ContainerPort>
        <Protocol>tcp</Protocol>
      </Port>
    </Publish>
  </Networking>
  <Data>
    <Volume>
      <HostDir>/mnt/user/appdata/lan-drop</HostDir>
      <ContainerDir>/data</ContainerDir>
      <Mode>rw</Mode>
    </Volume>
  </Data>
  <Environment>
    <Variable>
      <Value>Europe/Istanbul</Value>
      <Name>TZ</Name>
      <Mode/>
    </Variable>
  </Environment>
  <Config Name="WebUI Port" Target="7700" Default="7700" Mode="tcp" Description="Web interface port" Type="Port" Display="always" Required="true" Mask="false">7700</Config>
  <Config Name="Appdata Storage" Target="/data" Default="/mnt/user/appdata/lan-drop" Mode="rw" Description="Persistent storage directory for SQLite database, uploaded files, and server secrets (must be owned/writable by UID:GID 10001:10001)." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/lan-drop</Config>
  <Config Name="Timezone" Target="TZ" Default="Europe/Istanbul" Description="Container timezone" Type="Variable" Display="always" Required="false" Mask="false">Europe/Istanbul</Config>
</Container>
