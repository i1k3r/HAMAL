# HAMAL configuration. Copy to .env and adjust for your deployment.
LAN_DROP_LISTEN_ADDR=:7700
# Set this to the URL users will eventually scan or open.
# LAN_DROP_BASE_URL=http://192.168.1.100:7700
LAN_DROP_DATA_DIR=/data
LAN_DROP_DB_PATH=/data/hamal.db
# Supply a long random value in production, or omit it to generate and persist one in /data/secrets/server-secret.
# LAN_DROP_SERVER_SECRET=
LAN_DROP_MAX_TTL=24h
LAN_DROP_DEFAULT_TTL=1h
LAN_DROP_MIN_TTL=5m
LAN_DROP_MAX_FILE_SIZE=10GiB
LAN_DROP_MAX_ROOM_SIZE=10GiB
LAN_DROP_MAX_FILES_PER_ROOM=100
LAN_DROP_MAX_TOTAL_STORAGE=100GiB
LAN_DROP_MIN_FREE_SPACE=5GiB
LAN_DROP_CLEANUP_INTERVAL=1m
LAN_DROP_UPLOAD_IDLE_TIMEOUT=10m
LAN_DROP_LOG_FORMAT=json
LAN_DROP_LOG_LEVEL=info
# LAN_DROP_TRUSTED_PROXIES=10.0.0.0/8,192.168.0.0/16
LAN_DROP_SECURE_COOKIES=auto
